{% extends 'base.html.twig' %}

{% block title %}Ajouter des cartes{% endblock %}

{% block body %}
<div class="search">
    <input type="search" id="card_search_input" list="card_list" class="widthinput"> 
    <button type="button" id="card_search">rechercher</button>

</div>
    <table class="table_card"> 
    <tbody id="tbody" class="tbody">
    </tbody>
    </table>




    <div class="formflex">
            <div class="csv">
                <div> voluptates autem asperiores adipisci at eius? Porro id dolor nulla vero expedita qui. Dignissimos, sapiente.</div>
            </div>
        <div class="div_change">
            <div>
                    {{form_start(form)}}

                <div class="form">
                    {{ form_label(form.etat) }}
                    : {{ form_widget(form.etat) }}
                </div>

                <div class="form">
                    {{ form_label(form.quantite) }}
                    : {{ form_widget(form.quantite) }}
                </div>

                <div class="form">
                    : {{ form_widget(form.editions) }}
                </div>

                <div class="form">
                    {{ form_label(form.prix) }}
                    : {{ form_widget(form.prix) }}
                </div>

                <div class="form">
                    {{ form_widget(form.cardId) }}
                </div>
                
                <div class="button_submit">
                    <button type="submit">Ajouter</button>
                </div>
                

            </div>

            <div>
                <div class="imgpreview">
                    {% if card and card.image_uris is defined %}
    <img src="{{ card.image_uris.png }}" height="400">
{% elseif card and card.card_faces is defined %}
    <img src="{{ card.card_faces[0].image_uris.png }}" height="400">
{% else %}
    <img src="" height="400">
{% endif %}
                </div>
            </div>  
        </div>    
    </div>
    {{ form_end(form)}}  






{% endblock %}
